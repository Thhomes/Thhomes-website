# Google SMTP (use a Google App Password, never your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-google-workspace-address@example.com
SMTP_APP_PASSWORD=your-16-character-google-app-password

# Mail routing
MAIL_FROM_NAME=TH Homes Projects
MAIL_FROM_ADDRESS=no-reply@th-homes.com
MAIL_TO_ADDRESS=enquiries@example.com

# Public production origin used for email images, without a trailing slash
MAIL_ASSET_BASE_URL=https://www.example.com
