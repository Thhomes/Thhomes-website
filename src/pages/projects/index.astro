---
import BaseLayout from '../../layouts/BaseLayout.astro';
const categories = ['All','Residential','Commercial','Industrial','Hospitality','Institutional','Infrastructure','Renovation','Interior design'];
const projects = [
  {name:'Courtyard House',location:'Abuja, Nigeria',type:'Residential',status:'Concept',image:'/Images/optimized/luxury-front.webp',scope:'Architecture · Residential development'},
  {name:'Garden Residence',location:'Abuja, Nigeria',type:'Residential',status:'Concept',image:'/Images/optimized/luxury-side.webp',scope:'Architecture · Interior planning'},
  {name:'Horizon Villas',location:'Abuja, Nigeria',type:'Residential',status:'Proposed',image:'/Images/3d-home.jpeg',scope:'Architecture · Property development'},
  {name:'Terrace Collection',location:'Abuja, Nigeria',type:'Residential',status:'Proposed',image:'/Images/beautiful-home.jpeg',scope:'Design · Construction'},
  {name:'Urban House',location:'Abuja, Nigeria',type:'Residential',status:'Concept',image:'/Images/classy-home.jpeg',scope:'Architecture · Landscape'},
  {name:'Civic Court',location:'Nigeria',type:'Commercial',status:'Proposed',image:'/Images/custom-home.jpeg',scope:'Feasibility · Concept design'},
];
---
<BaseLayout title="Our Projects — TH Homes" description="Explore residential, commercial and development projects by TH Homes."><section class="page-hero projects-hero"><div class="page-hero-inner"><h1>Projects defined by purpose, place and detail.</h1><p>A growing portfolio across residential, commercial and development-led work. Project information will expand as verified delivery records become available.</p></div></section><section class="section"><div class="section-inner"><nav class="project-filters" aria-label="Project categories">{categories.map((category,index) => <button type="button" class:list={{active:index===0}}>{category}</button>)}</nav><div class="project-grid">{projects.map((project,index) => <article class:list={['project-entry',index===0&&'project-entry-featured']} data-reveal><div class="project-entry-image"><img src={project.image} alt={`${project.name}, ${project.type.toLowerCase()} project`} width="1728" height="1080" loading={index<2?'eager':'lazy'} /></div><div class="project-entry-meta"><div><h2>{project.name}</h2><p>{project.location} · {project.type}</p></div><div><span class="project-status">{project.status}</span><p>{project.scope}</p></div></div></article>)}</div></div></section><section class="cta-band" data-reveal><h2>Planning something of your own?</h2><a class="button" href="/consultation">Start a project</a></section></BaseLayout>
