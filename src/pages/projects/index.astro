---
import BaseLayout from '../../layouts/BaseLayout.astro';
const projects = [
  {name:'Courtyard House',status:'Concept',image:'/Images/courtyard.jpg',scope:'Architecture · Development study'},
  {name:'Garden Residence',status:'Concept',image:'/Images/optimized/luxury-side.webp',scope:'Architecture · Interior planning'},
  {name:'Horizon Villas',status:'Proposed',image:'/Images/3d-home.jpeg',scope:'Architecture · Development study'},
  {name:'Terrace Collection',status:'Proposed',image:'/Images/beautiful-home.jpeg',scope:'Design · Construction study'},
  {name:'Urban House',status:'Concept',image:'/Images/classy-home.jpeg',scope:'Architecture · Landscape study'},
  {name:'Civic Court',status:'Proposed',image:'/Images/custom-home.jpeg',scope:'Feasibility · Concept design'},
];
---
<BaseLayout title="Our Projects — TH Homes" description="Explore architectural and development concepts by TH Homes."><section class="page-hero projects-hero projects-showcase-hero"><div class="project-hero-gallery" aria-hidden="true"><img src="/Images/courtyard.jpg" alt="" /><img src="/Images/optimized/luxury-side.webp" alt="" /><img src="/Images/3d-home.jpeg" alt="" /></div><div class="page-hero-inner"><h1>Projects defined by purpose, place and detail.</h1><p>A growing visual portfolio of concepts and proposed work. Verified delivery records will be added as projects progress.</p></div></section><section class="section"><div class="section-inner"><div class="project-grid">{projects.map((project,index) => <article class:list={['project-entry',index===0&&'project-entry-featured']} data-reveal><div class="project-entry-image"><img src={project.image} alt={`${project.name} architectural concept`} width="1728" height="1080" loading={index<2?'eager':'lazy'} /></div><div class="project-entry-meta"><h2>{project.name}</h2><div><span class="project-status">{project.status}</span><p>{project.scope}</p></div></div></article>)}</div></div></section><section class="cta-band cta-pattern" data-reveal><h2>Planning something of your own?</h2><a class="button" href="/consultation">Start a project</a></section></BaseLayout>
