---
import BaseLayout from '../layouts/BaseLayout.astro';
const services = [['Architecture & design','From early concepts and feasibility through coordinated design and detailed specification.'],['Construction','Disciplined delivery for considered residential and commercial environments.'],['Property development','Identifying potential, shaping viable opportunities and creating lasting real-estate value.'],['Project management','Clear oversight of scope, programme, quality, cost and the decisions that connect them.']];
const process = [['Discover','We clarify the land, ambition, constraints and measures of success.'],['Define','The brief becomes a coordinated design, delivery strategy and commercial plan.'],['Deliver','One accountable team controls quality, communication and progress.'],['Complete','We guide the project through handover and the life that follows.']];
---
<BaseLayout title="TH Homes — Building Beyond Expectations" description="International architecture, construction and property development from Abuja, Nigeria.">
  <section class="hero"><div class="hero-media"><video data-ambient-video data-playback-rate="0.72" muted loop playsinline preload="metadata" poster="/videos/posters/home.webp" aria-label="Contemporary residence"><source src="/videos/home.mp4" type="video/mp4" /></video></div><div class="hero-content"><h1>Building Beyond Expectations.</h1><div class="hero-copy"><p>Integrated architecture, construction and property development for clients who value thoughtful design, clear delivery and lasting quality.</p><div class="hero-actions"><a class="button" href="/consultation">Start a project</a></div></div></div></section>
  <section class="section" id="about"><div class="section-inner intro-grid" data-reveal><p class="intro-copy">One accountable team from first sketch to final handover.</p><div class="intro-aside"><p>TH Homes brings architecture, construction and development expertise into one considered process. Based in Abuja and built with an international outlook, we create environments that are purposeful, enduring and deeply connected to how people live and work.</p><a class="text-link" href="/consultation">Talk to our team <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="studio-film" data-reveal><video data-ambient-video muted loop playsinline preload="none" poster="/videos/posters/architecture-design.webp" aria-label="Architectural drawings and design materials"><source src="/videos/architecture-design.mp4" type="video/mp4" /></video><div class="studio-film-copy"><p>Architecture is where every project begins to become real.</p><span>Design · Detail · Delivery</span></div></section>
  <section class="section services" id="services"><div class="section-inner"><div class="section-head" data-reveal><h2>Designed as one continuous process.</h2><p>Four connected capabilities remove the gaps between vision, design, commercial decisions and delivery.</p></div><div class="service-list" data-reveal>{services.map(([title, copy]) => <a class="service-row" href="/consultation"><h3>{title}</h3><p>{copy}</p><span class="service-arrow" aria-hidden="true">→</span></a>)}</div></div></section>
  <section class="section projects" id="projects"><div class="section-inner"><div class="section-head" data-reveal><h2>Spaces shaped around a bigger idea.</h2><p>Residential, commercial and development-led work explored through proportion, material, context and long-term value.</p></div><div class="project-stage" data-reveal><article class="project-main"><img src="/Images/classic-home.jpeg" alt="Contemporary multi-storey residence" width="1728" height="1080" loading="lazy" /><div class="project-caption"><h3>Courtyard House</h3><span>View project</span></div></article><div class="project-side"><article class="project-small"><img src="/Images/pool-home.jpeg" alt="Modern residence with swimming pool" width="680" height="453" loading="lazy" /><div class="project-caption"><h3>Garden Residence</h3></div></article><article class="project-small"><img src="/Images/3d-home.jpeg" alt="Architectural view of a contemporary villa" width="1024" height="768" loading="lazy" /><div class="project-caption"><h3>Horizon Villas</h3></div></article></div></div></div></section>
  <section class="section process"><div class="section-inner"><div class="process-intro"><div class="process-heading" data-reveal><h2>A clear road from ambition to arrival.</h2><p>Every stage has a purpose, a decision and an accountable owner. That is how complexity becomes confidence.</p></div><div class="process-film" data-reveal><video data-ambient-video muted loop playsinline preload="none" poster="/videos/posters/planning.webp" aria-label="Project team reviewing architectural plans"><source src="/videos/planning.mp4" type="video/mp4" /></video></div></div><div class="process-track" data-reveal>{process.map(([title, copy]) => <div class="process-step"><span class="process-dot"></span><h3>{title}</h3><p>{copy}</p></div>)}</div></div></section>
  <section class="global-teaser" data-reveal><div class="global-image"><img src="/Images/globe.jpeg" alt="World map suggesting TH Homes' international outlook" width="1200" height="540" loading="lazy" /></div><div class="global-copy"><h2>Rooted in Abuja. Ready for international briefs.</h2><p>Our current focus begins in Nigeria. Our structure is designed to support carefully selected projects, partnerships and future regional growth across global markets.</p><a class="text-link light" href="/global-presence">Explore our global outlook <span aria-hidden="true">↗</span></a></div></section>
  <section class="cta-band" data-reveal><h2>Have a project in mind?</h2><a class="button" href="/consultation">Request a consultation</a></section>
</BaseLayout>
