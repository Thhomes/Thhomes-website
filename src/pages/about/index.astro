---
import BaseLayout from '../../layouts/BaseLayout.astro';
const values = [['Excellence','High standards in every project.'],['Integrity','Honest and accountable delivery.'],['Innovation','Modern solutions to building challenges.'],['Sustainability','Responsible development.'],['Collaboration','Strong client and partner relationships.'],['Precision','Attention to technical detail.']];
---
<BaseLayout title="About Us — TH Homes" description="The story, purpose, values and global ambition behind TH Homes Projects.">
  <section class="page-hero page-hero-image"><img src="/Images/hero-3.jpeg" alt="Contemporary architectural structure" width="1252" height="966" /><div class="page-hero-inner"><h1>Built on clarity, responsibility and lasting value.</h1><p>TH Homes is an integrated architecture, construction and property development company based in Abuja, Nigeria, with an international outlook.</p></div></section>
  <section class="section"><div class="section-inner about-opening" data-reveal><h2>Who we are</h2><div><p class="lead-copy">We bring design thinking, delivery discipline and development insight into one accountable organisation.</p><p>Our purpose is to create well-considered places while giving clients a clearer path through the complexity of building. The company begins in Abuja and is structured to grow carefully through credible projects, strong partnerships and locally informed delivery.</p></div></div></section>
  <section class="about-story"><div class="about-story-image" data-reveal><img src="/Images/careers.jpeg" alt="Architecture and construction professionals collaborating" width="1920" height="1280" loading="lazy" /></div><div class="about-story-copy" data-reveal><h2>Our story</h2><p>TH Homes was formed around a simple belief: architecture, construction and development decisions are stronger when they are considered together. That integrated philosophy shapes how we approach briefs, coordinate expertise and remain accountable from the earliest conversation through delivery.</p><h3>Our philosophy</h3><p>Design with purpose. Build with discipline. Develop with a long-term view.</p></div></section>
  <section class="section vision-section"><div class="section-inner vision-grid"><article data-reveal><h2>Vision</h2><p>To build an internationally respected company known for thoughtful environments, dependable delivery and responsible growth.</p></article><article data-reveal><h2>Mission</h2><p>To combine architecture, construction and property development expertise to create lasting value for clients, communities and partners.</p></article></div></section>
  <section class="section"><div class="section-inner"><div class="section-head" data-reveal><h2>Values made visible in the work.</h2><p>These principles guide decisions, relationships and the standard expected across every service.</p></div><div class="values-list" data-reveal>{values.map(([name, meaning]) => <article><h3>{name}</h3><p>{meaning}</p></article>)}</div></div></section>
  <section class="section governance"><div class="section-inner split-page"><div data-reveal><h2>Leadership and management</h2><p>Leadership profiles will present verified professional biographies, qualifications, relevant experience and areas of responsibility as the management team is confirmed.</p><a class="text-link" href="/contact">Contact the company <span aria-hidden="true">↗</span></a></div><div data-reveal><h3>Our people</h3><p>TH Homes is being built around multidisciplinary collaboration between design, technical, commercial and delivery professionals.</p><h3>Corporate governance</h3><p>Clear responsibilities, accountable decision-making and responsible management underpin sustainable growth.</p><h3>Health, safety and quality</h3><p>Safe working, considered risk management and consistent quality controls are treated as core delivery responsibilities.</p></div></div></section>
  <section class="global-teaser" data-reveal><div class="global-image"><img src="/Images/globe.jpeg" alt="World map representing the company's global ambition" width="1200" height="540" loading="lazy" /></div><div class="global-copy"><h2>Our global ambition</h2><p>Our ambition is international, but our growth will be evidence-led. We begin with Abuja, welcome selected international enquiries and expand through capability, partnerships and real delivery.</p><a class="text-link light" href="/global-presence">View our regional outlook <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
