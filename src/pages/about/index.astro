---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
const values = [['Excellence','High standards in every project.'],['Integrity','Honest and accountable delivery.'],['Innovation','Modern solutions to building challenges.'],['Sustainability','Responsible development.'],['Collaboration','Strong client and partner relationships.'],['Precision','Attention to technical detail.']];
---
<BaseLayout title="About Us — TH Homes" description="The story, purpose and values behind TH Homes Projects, based in Abuja.">
  <section class="page-hero page-hero-image about-hero"><img class="about-hero-main" src="/Images/hero-3.jpeg" alt="Contemporary architectural structure" width="1252" height="966" /><div class="page-hero-inner"><h1>Built on clarity, responsibility and lasting value.</h1><p>TH Homes is an integrated architecture, construction, interior design and property development company based in Abuja, Nigeria.</p></div></section>
  <section class="section"><div class="section-inner about-opening" data-reveal><h2>Who we are</h2><div><p class="lead-copy">We bring design thinking, delivery discipline and development insight into one accountable organisation.</p><p>Our purpose is to create well-considered places while giving clients a clearer path through the complexity of building. The company begins in Abuja and is structured to grow carefully through credible projects, strong partnerships and locally informed delivery.</p></div></div></section>
  <section class="about-story"><div class="about-story-image" data-reveal><img src="/Images/careers.jpeg" alt="Architecture and construction professionals collaborating" width="1920" height="1280" loading="lazy" /></div><div class="about-story-copy" data-reveal><h2>Our story</h2><p>TH Homes was formed around a simple belief: architecture, construction and development decisions are stronger when they are considered together. That integrated philosophy shapes how we approach briefs, coordinate expertise and remain accountable from the earliest conversation through delivery.</p><h3>Our philosophy</h3><p>Design with purpose. Build with discipline. Develop with a long-term view.</p></div></section>
  <section class="section vision-section"><div class="section-inner vision-grid"><article data-reveal><h2>Vision</h2><p>To shape thoughtful environments through dependable delivery, responsible growth and work that earns trust.</p></article><article data-reveal><h2>Mission</h2><p>To combine architecture, construction, interior design and property development expertise to create lasting value for clients and communities.</p></article></div></section>
  <section class="section"><div class="section-inner"><div class="section-head" data-reveal><h2>Values made visible in the work.</h2><p>These principles guide decisions, relationships and the standard expected across every service.</p></div><div class="values-list" data-reveal>{values.map(([name, meaning]) => <article><h3>{name}</h3><p>{meaning}</p></article>)}</div></div></section>
  <section class="section governance"><div class="section-inner split-page"><div data-reveal><h2>Leadership and management</h2><p>Leadership profiles will present verified professional biographies, qualifications, relevant experience and areas of responsibility as the management team is confirmed.</p><a class="text-link" href="/contact">Contact the company <ArrowIcon /></a></div><div data-reveal><h3>Our people</h3><p>TH Homes is being built around multidisciplinary collaboration between design, technical, commercial and delivery professionals.</p><h3>Corporate governance</h3><p>Clear responsibilities, accountable decision-making and responsible management underpin sustainable growth.</p><h3>Health, safety and quality</h3><p>Safe working, considered risk management and consistent quality controls are treated as core delivery responsibilities.</p></div></div></section>
  <section class="global-teaser abuja-teaser" data-reveal><div class="global-image"><img src="/Images/home-front-design-2.jpeg" alt="Contemporary residential proposal by TH Homes" width="4000" height="3200" loading="lazy" /></div><div class="global-copy"><h2>Close to the work.</h2><p>Our Abuja base keeps us close to our priority market, while the right project can take our design and delivery approach further.</p><a class="text-link light" href="/abuja">See where we work <ArrowIcon /></a></div></section>
</BaseLayout>
