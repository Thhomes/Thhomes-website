---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
const services = [
  ['architecture-design','Architecture & Design','Ideas resolved into practical, coordinated environments.','', '/Images/optimized/building-model.webp',['Concept design','Architectural drawings','Building planning','3D visualisation','Interior architecture','Landscape design','Space planning','Design consultancy']],
  ['construction','Construction Services','Disciplined delivery across new-build, refurbishment and fit-out.','', '/videos/posters/construction.webp',['Residential buildings','Commercial buildings','Industrial buildings','Structural works','Civil engineering','Building refurbishment','Renovation and extensions','Finishing and fit-out']],
  ['property-development','Property Development','Development thinking that connects land, feasibility and long-term value.','', '/Images/optimized/luxury-front.webp',['Residential development','Commercial development','Mixed-use development','Land development','Development feasibility','Joint venture developments','Real estate investment projects']],
  ['project-management','Project Management','Clear control of programme, procurement, cost, risk and quality.','', '/Images/optimized/subject-modeling.webp',['Project planning','Cost control','Procurement management','Construction supervision','Programme management','Quality management','Risk management','Handover and close-out']],
];
---
<BaseLayout title="Our Services — TH Homes" description="Architecture, construction, property development and project management services from TH Homes.">
  <section class="page-hero page-hero-video services-hero"><video data-ambient-video muted loop playsinline preload="metadata" poster="/Images/construction-workers.jpg" aria-label="Construction professionals at work"><source src="/videos/construction-workers.mp4" type="video/mp4" /></video><div class="page-hero-inner"><h1>Capability connected from the beginning.</h1><p>Our services can be commissioned independently or brought together as one coordinated path from early vision to completed project.</p></div><span class="hero-media-note">Design · Build · Develop · Manage</span></section>
  <section class="section"><div class="section-inner services-editorial">{services.map(([slug,title,summary,,image,items], index) => <article class="service-feature" data-reveal><div class="service-feature-media"><img src={image} alt="" width="1920" height="1280" loading={index === 0 ? 'eager' : 'lazy'} /></div><div class="service-feature-copy"><h2>{title}</h2><p>{summary}</p><ul>{(items as string[]).map(item => <li>{item}</li>)}</ul><a class="text-link" href={`/services/${slug}`}>Explore this service <ArrowIcon /></a></div></article>)}</div></section>
  <section class="cta-band cta-pattern" data-reveal><h2>Not sure where your project fits?</h2><a class="button" href="/consultation">Talk to our team</a></section>
</BaseLayout>
