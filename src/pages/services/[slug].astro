---
import BaseLayout from '../../layouts/BaseLayout.astro';
export function getStaticPaths(){
  const services = {
    'architecture-design': { title:'Architecture & Design', intro:'We translate ambition, context and constraints into coordinated design decisions that can be understood, approved and built.', image:'/Images/hero-2.jpeg', items:['Concept design','Architectural drawings','Building planning','3D visualisation','Interior architecture','Landscape design','Space planning','Design consultancy'] },
    'construction': { title:'Construction Services', intro:'We coordinate people, materials, programme and quality to deliver considered residential, commercial and specialist building work.', image:'/Images/classy-home-2.jpeg', items:['Residential buildings','Commercial buildings','Industrial buildings','Structural works','Civil engineering','Building refurbishment','Renovation and extensions','Finishing and fit-out'] },
    'property-development': { title:'Property Development', intro:'We assess land and opportunities through design, commercial feasibility, partnership structure and long-term real-estate value.', image:'/Images/luxury-home-2.jpeg', items:['Residential development','Commercial development','Mixed-use development','Land development','Development feasibility','Joint venture developments','Real estate investment projects'] },
    'project-management': { title:'Project Management', intro:'We establish the controls, reporting and decision structure required to keep complex projects clear and accountable.', image:'/Images/careers.jpeg', items:['Project planning','Cost control','Procurement management','Construction supervision','Programme management','Quality management','Risk management','Handover and close-out'] },
  };
  return Object.entries(services).map(([slug,service]) => ({params:{slug},props:{service}}));
}
const { service } = Astro.props;
---
<BaseLayout title={`${service.title} — TH Homes`} description={`${service.title} services from TH Homes Projects.`}><section class="service-detail-hero"><img src={service.image} alt="" width="1920" height="1280" /><div><h1>{service.title}</h1><p>{service.intro}</p></div></section><section class="section"><div class="section-inner split-page"><div data-reveal><h2>What we deliver</h2><p>Every commission begins with a clear understanding of scope, responsibilities, constraints and the outcome the project needs to achieve.</p></div><div class="deliverables" data-reveal>{service.items.map((item:string) => <div><span>{item}</span></div>)}</div></div></section><section class="cta-band" data-reveal><h2>Discuss your {service.title.toLowerCase()} brief.</h2><a class="button" href="/consultation">Request a consultation</a></section></BaseLayout>
