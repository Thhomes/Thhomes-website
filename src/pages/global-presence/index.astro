---
import BaseLayout from '../../layouts/BaseLayout.astro';

const regions = [
  { id:'africa', name:'Africa', status:'Initial market', copy:'Current project focus in Abuja, with future coverage across West, East, Southern and North Africa.' },
  { id:'europe', name:'Europe', status:'Future coverage', copy:'Accepting conversations for selected opportunities across the UK and European markets.' },
  { id:'middle-east', name:'Middle East', status:'Future coverage', copy:'A long-term focus on the UAE, Saudi Arabia, Qatar and neighbouring markets.' },
  { id:'north-america', name:'North America', status:'Future coverage', copy:'Selected future development and partnership opportunities in the USA and Canada.' },
  { id:'asia-pacific', name:'Asia-Pacific', status:'Future coverage', copy:'Selective international opportunities across established Asian and Pacific markets.' },
  { id:'south-america', name:'South America', status:'Future coverage', copy:'Longer-term development and partnership opportunities as the company grows.' },
];
---
<BaseLayout title="Global Presence — TH Homes" description="TH Homes' current market, international enquiry coverage and future regional growth.">
  <section class="page-hero page-hero-video global-presence-hero">
    <video data-ambient-video muted loop playsinline preload="metadata" poster="/Images/globe.jpeg" aria-label="International city and travel imagery"><source src="/videos/global-presence.mp4" type="video/mp4" /></video>
    <div class="page-hero-inner">
      <h1>Global thinking, grounded growth.</h1>
      <p>We are building an international company region by region—beginning with Abuja, working through credible partnerships and expanding only where our delivery capability supports it.</p>
    </div>
  </section>

  <section class="section global-journey" data-global-journey>
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <h2>A considered path from Abuja to the world.</h2>
        <p>This roadmap distinguishes our initial market from future coverage. It is an outlook, not a claim of established offices.</p>
      </div>
      <div class="journey-layout" data-reveal>
        <div class="journey-map" aria-hidden="true">
          <img src="/Images/globe.jpeg" alt="" width="1200" height="540" />
          <svg viewBox="0 0 1000 540" preserveAspectRatio="none">
            <path class="journey-route" d="M500 285 C430 230 350 205 255 180 S112 150 80 170 M500 285 C520 210 555 165 600 145 M500 285 C590 260 690 245 790 245 S900 220 940 175 M500 285 C430 350 350 400 270 430 M500 285 C610 345 720 400 845 430" />
            <circle class="journey-origin" cx="500" cy="285" r="8" />
          </svg>
          <span class="journey-map-label">Abuja · Initial market</span>
        </div>
        <div class="journey-panel">
          <div class="journey-tabs" role="tablist" aria-label="Regional outlook">
            {regions.map((region, index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-region-index={index}><span>{String(index + 1).padStart(2, '0')}</span>{region.name}</button>)}
          </div>
          <div class="journey-detail" aria-live="polite">
            <span class="region-status" data-region-status>{regions[0].status}</span>
            <h3 data-region-name>{regions[0].name}</h3>
            <p data-region-copy>{regions[0].copy}</p>
            <a class="text-link light" href="/consultation">International project enquiry <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-head" data-reveal><h2>Regional outlook</h2><p>Project acceptance depends on location, scope, partners and delivery readiness.</p></div>
      <div class="region-list" data-reveal>{regions.map((region) => <article class="region"><h3>{region.name}</h3><p>{region.copy}</p><span class="region-status">{region.status}</span></article>)}</div>
    </div>
  </section>
  <section class="cta-band cta-pattern" data-reveal><h2>Planning across borders?</h2><a class="button" href="/consultation">Start the conversation</a></section>

  <script define:vars={{ regions }} is:inline>
    const root = document.querySelector('[data-global-journey]');
    const buttons = root?.querySelectorAll('[data-region-index]') ?? [];
    const name = root?.querySelector('[data-region-name]');
    const status = root?.querySelector('[data-region-status]');
    const copy = root?.querySelector('[data-region-copy]');
    const detail = root?.querySelector('.journey-detail');

    buttons.forEach((button) => button.addEventListener('click', () => {
      const region = regions[Number(button.dataset.regionIndex)];
      if (!region || !name || !status || !copy || !detail) return;
      buttons.forEach((item) => item.setAttribute('aria-selected', String(item === button)));
      name.textContent = region.name;
      status.textContent = region.status;
      copy.textContent = region.copy;
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        detail.animate([{ opacity:.35, transform:'translateY(8px)' }, { opacity:1, transform:'none' }], { duration:300, easing:'cubic-bezier(.23,1,.32,1)' });
      }
    }));
  </script>
</BaseLayout>
