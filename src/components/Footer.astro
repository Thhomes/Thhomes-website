---
import ArrowIcon from './ArrowIcon.astro';
---
<footer class="site-footer">
  <div class="footer-lead">
    <p class="footer-title">Building Beyond Expectations.</p>
    <a class="text-link light" href="/consultation">Start a project <ArrowIcon /></a>
  </div>
  <div class="footer-grid">
    <div>
      <a class="brand footer-brand" href="/" aria-label="TH Homes home">
        <img class="brand-logo footer-logo" src="/Images/logo/thhome-white-logo.png" alt="" width="2172" height="724" loading="lazy" />
      </a>
      <p>Architecture. Construction.<br />Property Development.</p>
    </div>
    <div>
      <p class="footer-label">Explore</p>
      <a href="/about">About</a><a href="/services">Services</a><a href="/projects">Projects</a><a href="/global-presence">Global presence</a>
    </div>
    <div>
      <p class="footer-label">Contact</p>
      <a href="tel:+2348000000000">+234 800 000 0000</a><a href="mailto:hello@thhomes.example">hello@thhomes.example</a><p>Central Business District<br />Abuja, Nigeria</p>
    </div>
    <div>
      <p class="footer-label">Follow</p>
      <a href="#">LinkedIn</a><a href="#">Instagram</a><a href="#">YouTube</a>
    </div>
  </div>
  <div class="footer-base"><span>© {new Date().getFullYear()} TH Homes Projects</span><span>Privacy · Cookies · Accessibility</span></div>
</footer>
