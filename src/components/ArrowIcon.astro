---
interface Props {
  direction?: 'right' | 'up-right';
}

const { direction = 'up-right' } = Astro.props;
const path = direction === 'right' ? 'M5 12h14m-5-5 5 5-5 5' : 'M7 17 17 7M8 7h9v9';
---
<svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d={path}></path>
</svg>
