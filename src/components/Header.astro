---
const pathname = Astro.url.pathname;
const links = [
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Projects' },
  { href: '/global-presence', label: 'Global presence' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="TH Homes home">
    <img class="brand-logo" src="/Images/logo/thhome-white-logo.png" alt="" width="2172" height="724" />
  </a>
  <nav class="desktop-nav" aria-label="Primary navigation">
    {links.map((link) => (
      <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
  <a class="button button-small desktop-cta" href="/consultation">Request a consultation</a>
  <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" data-menu-button>
    <span></span><span></span>
  </button>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" data-menu>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="button" href="/consultation">Request a consultation</a>
  </nav>
</header>
